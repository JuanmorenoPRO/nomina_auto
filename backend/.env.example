# Copiar a .env y completar. El .env real NUNCA se versiona (.gitignore).
# Desarrollo: SQLite. Producción: PostgreSQL.
DATABASE_URL=sqlite:///./nomina_dev.sqlite3
# DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/nomina

# Clave para firmar sesiones (generar con: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=

# Orígenes permitidos para CORS (frontend)
CORS_ORIGINS=http://localhost:5174

# Sesiones
DURACION_SESION_HORAS=12
# En producción con HTTPS: true (cookie Secure + HSTS)
COOKIE_SEGURA=false

# Directorio del build de Vite (vacio en dev, el Dockerfile lo setea en prod)
STATIC_DIR=

# Bootstrap del primer admin (se crea automaticamente al arrancar si no existe ninguno)
NOMINA_ADMIN_EMAIL=
NOMINA_ADMIN_PASSWORD=
